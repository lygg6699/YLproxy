<Application x:Class="YLproxy.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YLproxy.GUI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题将在运行时通过 ThemeService 动态加载 -->
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <conv:ApiStatusColorConverter x:Key="ApiStatusColorConverter"/>
            <conv:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
