<Window x:Class="YLproxy.GUI.Views.ManageGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="分组管理"
        Width="420"
        Height="380"
        MinWidth="320"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="分组列表" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup}"
                 Margin="0,0,0,10"/>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GroupNameTextBox" Grid.Column="0"
                     Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="添加分组"
                    Command="{Binding AddGroupCommand}"
                    CommandParameter="{Binding ElementName=GroupNameTextBox, Path=Text}"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="重命名" Command="{Binding RenameGroupCommand}" Width="80" Margin="0,0,6,0"/>
            <Button Content="删除" Command="{Binding DeleteGroupCommand}" Width="80" Margin="0,0,6,0"/>
            <Button Content="关闭" IsCancel="True" Width="80"/>
        </StackPanel>
    </Grid>
</Window>

