using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;
using Xunit;
using YLproxy.Api;
using YLproxy.Models;
using YLproxy.Models.Config;

namespace YLproxy.Tests;

/// <summary>
/// API 端点集成测试：通过真实 Kestrel 服务器验证完整 HTTP 请求-响应链路。
/// 覆盖认证、CRUD、输入验证、端口分配、统计等核心场景。
/// </summary>
[Trait("TestCategory", "ApiIntegration")]
public class ApiEndpointsIntegrationTests : IAsyncDisposable
{
    private readonly string _tempDir;
    private readonly string _configPath;
    private readonly ApiServer _server;
    private readonly HttpClient _client;
    private const string TestToken = "test-token-12345";

    public ApiEndpointsIntegrationTests()
    {
        _tempDir = Path.Combine(Path.GetTempPath(), $"ylproxy_api_{Guid.NewGuid():N}");
        Directory.CreateDirectory(_tempDir);
        _configPath = Path.Combine(_tempDir, "config.json");

        // 写入初始空配置
        File.WriteAllText(_configPath, JsonSerializer.Serialize(new AppConfig
        {
            Version = "1.1",
            Proxies = new List<ProxyItem>()
        }));

        var proxyConfig = new ProxyConfig { PortRangeStart = 9001, PortRangeEnd = 9100 };
        _server = new ApiServer(_configPath, proxyConfig, port: 0, accessToken: TestToken, enableSwagger: false);

        // 使用随机可用端口
        var listener = new System.Net.Sockets.TcpListener(IPAddress.Loopback, 0);
        listener.Start();
        int port = ((System.Net.IPEndPoint)listener.LocalEndpoint).Port;
        listener.Stop();

        // 重新创建使用确定端口
        _server = new ApiServer(_configPath, proxyConfig, port: port, accessToken: TestToken, enableSwagger: false);
        _server.StartAsync().GetAwaiter().GetResult();

        _client = new HttpClient { BaseAddress = new Uri($"http://127.0.0.1:{port}") };
    }

    public async ValueTask DisposeAsync()
    {
        _client?.Dispose();
        await _server.StopAsync();
        try { Directory.Delete(_tempDir, true); } catch { }
        GC.SuppressFinalize(this);
    }

    private HttpRequestMessage CreateRequest(HttpMethod method, string path, object? body = null)
    {
        var req = new HttpRequestMessage(method, path);
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TestToken);
        if (body is not null)
        {
            req.Content = new StringContent(JsonSerializer.Serialize(body), Encoding.UTF8, "application/json");
        }
        return req;
    }

    [Fact]
    public async Task HealthCheck_ReturnsOk_WithoutAuth()
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, "/api/health");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
    }

    [Fact]
    public async Task GetProxies_NoAuth_Returns401()
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, "/api/proxies");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
    }

    [Fact]
    public async Task GetProxies_InvalidToken_Returns401()
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, "/api/proxies");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", "wrong-token");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
    }

    [Fact]
    public async Task GetProxies_NonBearerScheme_Returns401()
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, "/api/proxies");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", "abc123");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.Unauthorized, resp.StatusCode);
    }

    [Fact]
    public async Task GetProxies_EmptyConfig_ReturnsEmptyList()
    {
        using var req = CreateRequest(HttpMethod.Get, "/api/proxies");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
        var content = await resp.Content.ReadFromJsonAsync<JsonElement>();
        Assert.True(content.GetProperty("success").GetBoolean());
        Assert.Equal(JsonValueKind.Array, content.GetProperty("data").ValueKind);
        Assert.Equal(0, content.GetProperty("data").GetArrayLength());
    }

    [Fact]
    public async Task AddProxy_ValidInput_Returns201()
    {
        var dto = new { name = "TestProxy", remoteHost = "1.2.3.4", remotePort = 8080, localPort = 0 };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        var content = await resp.Content.ReadFromJsonAsync<JsonElement>();
        Assert.True(content.GetProperty("success").GetBoolean());
        Assert.Equal("TestProxy", content.GetProperty("data").GetProperty("name").GetString());
        Assert.Equal(9001, content.GetProperty("data").GetProperty("localPort").GetInt32());
    }

    [Fact]
    public async Task AddProxy_MissingName_Returns400()
    {
        var dto = new { remoteHost = "1.2.3.4", remotePort = 8080 };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.BadRequest, resp.StatusCode);
    }

    [Fact]
    public async Task AddProxy_InvalidRemotePort_Returns400()
    {
        var dto = new { name = "Test", remoteHost = "1.2.3.4", remotePort = 70000 };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.BadRequest, resp.StatusCode);
    }

    [Fact]
    public async Task AddProxy_DuplicatePort_Returns409()
    {
        // 先添加一个代理占用端口 9001
        var dto1 = new { name = "First", remoteHost = "1.1.1.1", remotePort = 8080, localPort = 9001 };
        using (var req1 = CreateRequest(HttpMethod.Post, "/api/proxies", dto1))
        using (var resp1 = await _client.SendAsync(req1))
        {
            Assert.Equal(HttpStatusCode.Created, resp1.StatusCode);
        }

        // 再添加一个指定相同端口
        var dto2 = new { name = "Second", remoteHost = "2.2.2.2", remotePort = 8080, localPort = 9001 };
        using var req2 = CreateRequest(HttpMethod.Post, "/api/proxies", dto2);
        using var resp2 = await _client.SendAsync(req2);
        Assert.Equal(HttpStatusCode.Conflict, resp2.StatusCode);
    }

    [Fact]
    public async Task AddProxy_AutoPortAssignment_IncrementsCorrectly()
    {
        // 添加 3 个代理，验证自动端口分配 9001, 9002, 9003
        for (int i = 1; i <= 3; i++)
        {
            var dto = new { name = $"Proxy{i}", remoteHost = $"10.0.0.{i}", remotePort = 8080, localPort = 0 };
            using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
            using var resp = await _client.SendAsync(req);
            Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
            var content = await resp.Content.ReadFromJsonAsync<JsonElement>();
            Assert.Equal(9000 + i, content.GetProperty("data").GetProperty("localPort").GetInt32());
        }
    }

    [Fact]
    public async Task GetProxyById_Existing_Returns200()
    {
        // 先添加
        var dto = new { name = "FindMe", remoteHost = "1.2.3.4", remotePort = 8080, localPort = 0 };
        using (var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto))
        using (var resp = await _client.SendAsync(req))
        {
            Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        }

        // 查询 ID=1
        using var getReq = CreateRequest(HttpMethod.Get, "/api/proxies/1");
        using var getResp = await _client.SendAsync(getReq);
        Assert.Equal(HttpStatusCode.OK, getResp.StatusCode);
        var content = await getResp.Content.ReadFromJsonAsync<JsonElement>();
        Assert.Equal("FindMe", content.GetProperty("data").GetProperty("name").GetString());
    }

    [Fact]
    public async Task GetProxyById_NonExisting_Returns404()
    {
        using var req = CreateRequest(HttpMethod.Get, "/api/proxies/9999");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.NotFound, resp.StatusCode);
    }

    [Fact]
    public async Task DeleteProxy_Existing_Returns200()
    {
        // 先添加
        var dto = new { name = "ToDelete", remoteHost = "1.2.3.4", remotePort = 8080, localPort = 0 };
        using (var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto))
        using (var resp = await _client.SendAsync(req))
        {
            Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        }

        // 删除
        using var delReq = CreateRequest(HttpMethod.Delete, "/api/proxies/1");
        using var delResp = await _client.SendAsync(delReq);
        Assert.Equal(HttpStatusCode.OK, delResp.StatusCode);
    }

    [Fact]
    public async Task DeleteProxy_NonExisting_Returns404()
    {
        using var req = CreateRequest(HttpMethod.Delete, "/api/proxies/9999");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.NotFound, resp.StatusCode);
    }

    [Fact]
    public async Task GetStats_ReturnsCorrectCounts()
    {
        // 添加 2 个代理
        for (int i = 1; i <= 2; i++)
        {
            var dto = new { name = $"Proxy{i}", remoteHost = $"10.0.0.{i}", remotePort = 8080, localPort = 0 };
            using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
            using var resp = await _client.SendAsync(req);
            Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        }

        using var req = CreateRequest(HttpMethod.Get, "/api/stats");
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.OK, resp.StatusCode);
        var content = await resp.Content.ReadFromJsonAsync<JsonElement>();
        Assert.Equal(2, content.GetProperty("data").GetProperty("total").GetInt32());
        Assert.Equal(2, content.GetProperty("data").GetProperty("stopped").GetInt32());
        Assert.Equal(0, content.GetProperty("data").GetProperty("running").GetInt32());
    }

    [Fact]
    public async Task AddProxy_NameTooLong_Returns400()
    {
        var dto = new { name = new string('A', 201), remoteHost = "1.2.3.4", remotePort = 8080 };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.BadRequest, resp.StatusCode);
    }

    [Fact]
    public async Task AddProxy_MissingRemoteHost_Returns400()
    {
        var dto = new { name = "Test", remotePort = 8080 };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.BadRequest, resp.StatusCode);
    }

    [Fact]
    public async Task AddProxy_PasswordMaskedInResponse()
    {
        var dto = new { name = "SecretProxy", remoteHost = "1.2.3.4", remotePort = 8080, localPort = 0, username = "user", password = "secretpass" };
        using var req = CreateRequest(HttpMethod.Post, "/api/proxies", dto);
        using var resp = await _client.SendAsync(req);
        Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        var content = await resp.Content.ReadFromJsonAsync<JsonElement>();
        var password = content.GetProperty("data").GetProperty("password").GetString();
        Assert.Equal("****", password);
    }
}
